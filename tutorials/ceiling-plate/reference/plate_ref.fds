&HEAD CHID='plate_ref', TITLE='Reference: FDS native 1-D steel plate (10 mm, insulated back)' /
&MESH IJK=10,20,20, XB=0.0,1.0,0.0,2.0,0.0,2.0 /
&MESH IJK=10,20,20, XB=1.0,2.0,0.0,2.0,0.0,2.0 /
&TIME T_END=120. /
&MISC TMPA=20. /
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /

&SURF ID='BURNER', HRRPUA=937.5, COLOR='RED' /
&OBST XB=0.8,1.2,0.8,1.2,0.0,0.1, SURF_IDS='BURNER','INERT','INERT' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&MATL ID='STEEL', DENSITY=7850., CONDUCTIVITY=45.8, SPECIFIC_HEAT=0.46, EMISSIVITY=0.9 /
&SURF ID='PLATE', MATL_ID='STEEL', THICKNESS=0.01, BACKING='INSULATED', COLOR='GRAY 50' /
&VENT XB=0.5,1.5,0.5,1.5,2.0,2.0, SURF_ID='PLATE' /

&DEVC ID='TS_C',  QUANTITY='WALL TEMPERATURE', XYZ=1.0,1.0,2.0, IOR=-3 /
&DEVC ID='TS_E',  QUANTITY='WALL TEMPERATURE', XYZ=0.6,0.6,2.0, IOR=-3 /
&DEVC ID='Q_C',   QUANTITY='NET HEAT FLUX',    XYZ=1.0,1.0,2.0, IOR=-3 /
&DEVC ID='Q_E',   QUANTITY='NET HEAT FLUX',    XYZ=0.6,0.6,2.0, IOR=-3 /
&DEVC ID='TG_C',  QUANTITY='TEMPERATURE',      XYZ=1.0,1.0,1.95 /
&BNDF QUANTITY='WALL TEMPERATURE' /
&TAIL /
