&HEAD CHID='plate_fire', TITLE='FDS-preCICE-CalculiX: clamped steel plate heated by a 300 kW fire' /
&PRCI PARTICIPANT='Fluid', CONFIG_FILE='../precice-config.xml', MESH_NAME='Fluid-Mesh', SURF_ID='PLATE',
      COUPLING_MODE='DIRICHLET', TEMPERATURE_UNIT='K' /

&MESH IJK=10,20,20, XB=0.0,1.0,0.0,2.0,0.0,2.0 /
&MESH IJK=10,20,20, XB=1.0,2.0,0.0,2.0,0.0,2.0 /
&TIME T_END=180. /
&MISC TMPA=20. /
&REAC FUEL='PROPANE', SOOT_YIELD=0.01 /

&SURF ID='BURNER', HRRPUA=1875., COLOR='RED' /
&OBST XB=0.8,1.2,0.8,1.2,0.0,0.1, SURF_IDS='BURNER','INERT','INERT' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /

! Exposed face of the steel plate: temperature comes from CalculiX
&SURF ID='PLATE', TMP_FRONT=20., EMISSIVITY=0.9, COLOR='GRAY 50' /
&VENT XB=0.2,1.8,0.8,1.2,2.0,2.0, SURF_ID='PLATE' /

&DEVC ID='TS_MID',  QUANTITY='WALL TEMPERATURE', XYZ=1.0,1.0,2.0, IOR=-3 /
&DEVC ID='TS_Q',    QUANTITY='WALL TEMPERATURE', XYZ=0.6,1.0,2.0, IOR=-3 /
&DEVC ID='Q_MID',   QUANTITY='NET HEAT FLUX',    XYZ=1.0,1.0,2.0, IOR=-3 /
&DEVC ID='Q_Q',     QUANTITY='NET HEAT FLUX',    XYZ=0.6,1.0,2.0, IOR=-3 /
&DEVC ID='TG_MID',  QUANTITY='TEMPERATURE',      XYZ=1.0,1.0,1.95 /
&BNDF QUANTITY='WALL TEMPERATURE' /
&BNDF QUANTITY='NET HEAT FLUX' /
&SLCF PBY=1.0, QUANTITY='TEMPERATURE' /
&TAIL /
